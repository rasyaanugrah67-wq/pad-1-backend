{
    "openapi": "3.0.0",
    "info": {
        "title": "PAD - Website Perlombaan 17 Agustus API",
        "description": "Dokumentasi REST API Website Perlombaan 17 Agustus tingkat RT/RW.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Local Development Server"
        }
    ],
    "paths": {
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login pengguna",
                "description": "Login menggunakan username dan password untuk mendapatkan token Sanctum.",
                "operationId": "dd51a484b7fa0f97c7680fdbde14cf5f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "password"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "admin"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Admin123!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login berhasil"
                    },
                    "401": {
                        "description": "Username atau password salah"
                    },
                    "403": {
                        "description": "Akun tidak aktif"
                    },
                    "422": {
                        "description": "Validasi gagal"
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout pengguna",
                "description": "Menghapus token Sanctum yang sedang digunakan.",
                "operationId": "df9bdc6c7a6d9f20b983526b2ec0f698",
                "responses": {
                    "200": {
                        "description": "Logout berhasil"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/auth/me": {
            "get": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Mengambil data pengguna yang sedang login",
                "description": "Mengambil informasi akun berdasarkan token Sanctum.",
                "operationId": "b5de204f5e452ef51327c691aa99e77c",
                "responses": {
                    "200": {
                        "description": "Data pengguna berhasil diambil"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/warga/beranda": {
            "get": {
                "tags": [
                    "PB-02 Beranda Warga"
                ],
                "summary": "Menampilkan data beranda warga",
                "description": "Mengambil banner, jadwal lomba, pengumuman terbaru, dan pertandingan yang sedang berlangsung. Endpoint khusus role Warga.",
                "operationId": "getBerandaWarga",
                "parameters": [
                    {
                        "name": "tanggal",
                        "in": "query",
                        "description": "Tanggal agenda dengan format YYYY-MM-DD. Default menggunakan tanggal hari ini.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-08-15"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data beranda warga berhasil diambil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Data beranda warga berhasil diambil"
                                        },
                                        "data": {
                                            "properties": {
                                                "banner": {
                                                    "properties": {
                                                        "id_periode": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "judul": {
                                                            "type": "string",
                                                            "example": "Semarak HUT RI ke-81"
                                                        },
                                                        "tahun": {
                                                            "type": "string",
                                                            "example": "2026"
                                                        },
                                                        "deskripsi": {
                                                            "type": "string",
                                                            "example": "Nusantara Bersuka, Indonesia Berjaya"
                                                        },
                                                        "logo": {
                                                            "type": "string",
                                                            "nullable": true
                                                        }
                                                    },
                                                    "type": "object",
                                                    "nullable": true
                                                },
                                                "tanggal_filter": {
                                                    "type": "string",
                                                    "format": "date",
                                                    "example": "2026-08-15"
                                                },
                                                "jadwal_agenda": {
                                                    "type": "array",
                                                    "items": {
                                                        "properties": {
                                                            "id_jadwal": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "id_lomba": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "nama_lomba": {
                                                                "type": "string",
                                                                "example": "Tarik Tambang"
                                                            },
                                                            "nama_kategori": {
                                                                "type": "string",
                                                                "example": "Dewasa"
                                                            },
                                                            "tanggal": {
                                                                "type": "string",
                                                                "format": "date",
                                                                "example": "2026-08-15"
                                                            },
                                                            "waktu_mulai": {
                                                                "type": "string",
                                                                "example": "09:00:00"
                                                            },
                                                            "waktu_selesai": {
                                                                "type": "string",
                                                                "example": "11:00:00"
                                                            },
                                                            "lokasi": {
                                                                "type": "string",
                                                                "example": "Lapangan Timur"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "pengumuman_terbaru": {
                                                    "properties": {
                                                        "id_pengumuman": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "judul": {
                                                            "type": "string",
                                                            "example": "Pengumuman Jadwal Lomba 17 Agustus"
                                                        },
                                                        "isi": {
                                                            "type": "string",
                                                            "example": "Seluruh warga diharapkan hadir dan mengikuti perlombaan 17 Agustus."
                                                        },
                                                        "tanggal_publikasi": {
                                                            "type": "string",
                                                            "example": "2026-08-14 08:00:00"
                                                        }
                                                    },
                                                    "type": "object",
                                                    "nullable": true
                                                },
                                                "sedang_berlangsung": {
                                                    "description": "Daftar pertandingan yang berstatus Berlangsung",
                                                    "type": "array",
                                                    "items": {
                                                        "properties": {
                                                            "id_pertandingan": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "id_lomba": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "nama_lomba": {
                                                                "type": "string",
                                                                "example": "Tarik Tambang"
                                                            },
                                                            "peserta_1": {
                                                                "type": "string",
                                                                "example": "RT 01"
                                                            },
                                                            "peserta_2": {
                                                                "type": "string",
                                                                "example": "RT 02"
                                                            },
                                                            "waktu_mulai": {
                                                                "type": "string",
                                                                "example": "2026-08-15 09:00:00"
                                                            },
                                                            "status": {
                                                                "type": "string",
                                                                "example": "Berlangsung"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Pengguna belum login"
                    },
                    "403": {
                        "description": "Pengguna tidak memiliki role Warga"
                    },
                    "422": {
                        "description": "Format tanggal tidak valid"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Masukkan token Sanctum dari hasil login.",
                "bearerFormat": "Token",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "PB-02 Beranda Warga",
            "description": "PB-02 Beranda Warga"
        }
    ]
}